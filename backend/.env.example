# ─────────────────────────────────────────────────────────────────────────────
# AutoAce AI — Backend Environment Variables
# Copy to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=AutoAce AI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","https://your-frontend-domain.com"]

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-strong-password
SECRET_KEY=generate-a-strong-random-secret-key-here
TOKEN_EXPIRE_HOURS=24

# ── Upload ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500
ALLOWED_AUDIO_EXTENSIONS=[".wav",".mp3",".ogg",".flac",".m4a",".aac",".webm",".opus"]

# ── Audio Processing ──────────────────────────────────────────────────────────
TARGET_SAMPLE_RATE=16000
MAX_AUDIO_DURATION_SECONDS=600

# ── Emotion Model ─────────────────────────────────────────────────────────────
EMOTION_MODEL_NAME=ehcalabres/wav2vec2-lg-xlsr-en-speech-emotion-recognition
EMOTION_MODEL_CACHE_DIR=./models/emotion

# ── HuggingFace (optional, for gated models) ─────────────────────────────────
HUGGINGFACE_TOKEN=

# ── Silence Detection ─────────────────────────────────────────────────────────
SILENCE_THRESHOLD_DB=-40.0
LONG_SILENCE_MIN_DURATION_SECONDS=2.0

# ── Noise Detection ───────────────────────────────────────────────────────────
NOISE_SNR_THRESHOLD_DB=20.0
NOISE_SEVERITY_LOW_SNR=25.0
NOISE_SEVERITY_HIGH_SNR=15.0

# ── Audio Quality ─────────────────────────────────────────────────────────────
QUALITY_SNR_CLEAR_THRESHOLD=25.0
QUALITY_SNR_IMPAIRED_THRESHOLD=15.0
QUALITY_CLIPPING_THRESHOLD=0.98
QUALITY_CLIPPING_RATIO_MAX=0.001

# ── Overlap Detection ─────────────────────────────────────────────────────────
OVERLAP_ENERGY_THRESHOLD=0.02
OVERLAP_FRAME_LENGTH=2048
OVERLAP_HOP_LENGTH=512
OVERLAP_MIN_DURATION_SECONDS=0.5

# ── Confidence Score ──────────────────────────────────────────────────────────
CONFIDENCE_MODEL_WEIGHT=0.6
CONFIDENCE_FEATURE_WEIGHT=0.25
CONFIDENCE_HEURISTIC_WEIGHT=0.15
CONFIDENCE_MIN_DURATION_SECONDS=1.0

# ── Processing ────────────────────────────────────────────────────────────────
MAX_CONCURRENT_FILES=4
PROCESSING_TIMEOUT_SECONDS=120
